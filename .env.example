# ── Database (Neon) ─────────────────────────────────────────────────────────
# Neon pooled connection string. For local Postgres also set DATABASE_DRIVER=pg.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/schoolos?sslmode=require
# DATABASE_DRIVER=pg

# ── Clerk ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public URL of this app, used in invitation emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Secrets at rest ─────────────────────────────────────────────────────────
# Encrypts each school's WhatsApp/email API keys. 32+ random characters.
# Changing it makes existing stored keys unreadable.
SECRETS_ENCRYPTION_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Platform key: invitations, and school email when a school has no own key.
RESEND_API_KEY=
# Verified Resend domain; mail goes from noreply@<this>.
APP_EMAIL_DOMAIN=example.com

# ── WhatsApp (Whaple) ───────────────────────────────────────────────────────
# Each school stores its own Whaple key in Settings; this is the API base.
WHAPLE_API_URL=https://api.whaple.example
